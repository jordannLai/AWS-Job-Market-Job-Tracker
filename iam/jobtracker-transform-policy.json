{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::jobtracker-jordanlai-data",
            "Condition": {
                "StringLike": {
                    "s3:prefix": "raw/*"
                }
            }
        },
        {
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::jobtracker-jordanlai-data/raw/*"
        },
        {
            "Effect": "Allow",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::jobtracker-jordanlai-data/processed/*"
        }
    ]
}